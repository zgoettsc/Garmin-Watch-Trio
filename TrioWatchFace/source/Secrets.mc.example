using Toybox.Lang;

// Copy this file to Secrets.mc (same folder) and fill in your values.
// Secrets.mc is listed in .gitignore and must never be committed.
(:background)
module Secrets {
    // Your Nightscout site, no trailing slash.
    const NS_URL = "https://YOUR-SITE.example.com";

    // Nightscout access token with the "readable" role
    // (Nightscout > Admin Tools > Subjects > Add new Subject).
    // It looks like  watch-0123456789abcdef .  Use "" if the site is
    // readable without a token.
    const NS_TOKEN = "";
}
